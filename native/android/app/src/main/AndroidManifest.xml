<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminders are inexact (js/native.js notifyAt): no exact-alarm permission, which Play restricts to alarm and calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:name=".AppActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- Send cards (2026-11-07): a link with cards in it opens the app. The https one needs
                 site/public/.well-known/assetlinks.json to open without asking; skycollector:// always works. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="skycollector.app" android:pathPrefix="/c" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="skycollector" />
            </intent-filter>

        </activity>

        <!-- App icons (2026-11-19, Plus; Space Collector's scheme): the launcher entry is an alias, one per icon, and the
             app enables the one chosen (ReviewPlugin.setIcon, js/app-icons.js). The Original keeps the old component name
             .MainActivity, so an icon already on a home screen still points at something after the update. The real
             activity is .AppActivity; links and notifications open it. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".AppActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconFlightPlan"
            android:targetActivity=".AppActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_flightplan"
            android:roundIcon="@mipmap/ic_launcher_flightplan"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNightFlight"
            android:targetActivity=".AppActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nightflight"
            android:roundIcon="@mipmap/ic_launcher_nightflight"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCheatline"
            android:targetActivity=".AppActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cheatline"
            android:roundIcon="@mipmap/ic_launcher_cheatline"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlueprint"
            android:targetActivity=".AppActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blueprint"
            android:roundIcon="@mipmap/ic_launcher_blueprint"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGoldenAge"
            android:targetActivity=".AppActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_goldenage"
            android:roundIcon="@mipmap/ic_launcher_goldenage"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAirmail"
            android:targetActivity=".AppActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_airmail"
            android:roundIcon="@mipmap/ic_launcher_airmail"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCockpit"
            android:targetActivity=".AppActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cockpit"
            android:roundIcon="@mipmap/ic_launcher_cockpit"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Approximate location only (2026-10-12, store readiness): the app never asks for precise location, and the camera
         view is a testing-tools prototype, so neither FINE_LOCATION nor CAMERA is requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Portrait-only is not a hardware requirement (Space Collector 11d80083: Play's pre-review check inferred one and blocked a build) -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

</manifest>
