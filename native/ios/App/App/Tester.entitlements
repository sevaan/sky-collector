<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The Sky Tester app (native/build-tester.sh): only the App Group its widgets read from (group.app.skycollector.tester,
     registered 2026-11-19 with app.skycollector.tester.widgets). No iCloud backup, and skycollector.app links don't
     open it (skytester:// does). -->
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(SC_APP_ID)</string>
	</array>
</dict>
</plist>
