{
  "appId": "app.skycollector",
  "appName": "Sky Collector",
  "webDir": "www",
  "backgroundColor": "#8cc2ec",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#8cc2ec"
  },
  "android": {
    "backgroundColor": "#8cc2ec"
  },
  "plugins": {
    "SystemBars": {
      "style": "LIGHT"
    },
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    },
    "LocalNotifications": {
